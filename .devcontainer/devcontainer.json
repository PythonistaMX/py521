{
  "name": "py521 · IA Generativa en Entornos Locales (Pythonista)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "runArgs": ["--add-host=host.docker.internal:host-gateway"],

  "containerEnv": {
    "LLM_DEFAULT_BASE_URL": "http://host.docker.internal:11434/v1"
  },

  "secrets": {
    "LLM_BASE_URL": {
      "description": "Solo en Codespaces: URL de tu servicio compatible con OpenAI, con clave y HTTPS (por ejemplo, https://<tu-servicio>/v1). En VS Code local no hace falta.",
      "documentationUrl": "https://docs.github.com/es/codespaces/managing-your-codespaces/managing-your-account-specific-secrets-for-github-codespaces"
    },
    "LLM_API_KEY": {
      "description": "Solo en Codespaces: clave que exige tu servicio. Nunca la escribas en el repositorio.",
      "documentationUrl": "https://docs.github.com/es/codespaces/managing-your-codespaces/managing-your-account-specific-secrets-for-github-codespaces"
    }
  },

  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },

  "postCreateCommand": "python -m pip install --upgrade pip && pip install --no-cache-dir -r requirements.txt",

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.notebookFileRoot": "${workspaceFolder}",
        "files.exclude": {
          "**/__pycache__": true,
          "**/.ipynb_checkpoints": true
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    },
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  }
}

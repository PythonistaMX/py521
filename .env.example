# Configuración de las demos py521.
# Copia este archivo como .env y cambia solo lo que necesites. .env no se sube al repositorio.
# Las variables vacías o comentadas usan su valor por omisión (entre paréntesis).
# Nunca escribas aquí valores reales: este archivo de ejemplo sí se sube.
# En GitHub Codespaces, define LLM_BASE_URL y LLM_API_KEY como secretos de Codespaces en lugar de usar .env
# (ver «GitHub Codespaces» en el README). Las variables del sistema tienen prioridad sobre .env.

# --- Servicio compatible con OpenAI ---
# URL base de la API (http://localhost:11434/v1 = Ollama; en el contenedor de desarrollo, el valor de LLM_DEFAULT_BASE_URL).
# LM Studio: http://localhost:1234/v1 · llama.cpp server: http://localhost:9931/v1 · vLLM: http://localhost:8000/v1
LLM_BASE_URL=
# Secreto. Clave que se envía al servicio, solo si la pide (por ejemplo, el proxy de la demo 05). (sin valor)
LLM_API_KEY=

# --- Modelos ---
# Modelo de chat (qwen3:1.7b)
LLM_MODEL=
# Modelo de embeddings de la demo 04 (qwen3-embedding:0.6b)
LLM_EMBED_MODEL=
# Las dos versiones que compara la demo 03 (qwen3:1.7b-q4_K_M y qwen3:1.7b-q8_0)
LLM_MODEL_A=
LLM_MODEL_B=
# Las dos ventanas de contexto de la demo 03, en tokens (4096 y 16384)
LLM_CONTEXT_A=
LLM_CONTEXT_B=

# --- RAG (demo 04) ---
# Carpeta con documentos .md o .txt divididos en secciones "## " (data)
RAG_DOCS_DIR=

# --- Proxy con clave (demo 05) ---
# Secreto. Clave que exige el proxy; si está vacía, la demo genera una temporal. (sin valor)
# Créala con la sección 3.2 de 00_preliminares_entorno_y_secretos.ipynb.
LLM_PROXY_KEY=
# Dirección y puerto de escucha del proxy (127.0.0.1 y 8800). Usa la IP de la red local solo con cortafuegos.
LLM_PROXY_HOST=
LLM_PROXY_PORT=

# --- Funciones específicas de Ollama ---
# API nativa de Ollama; por omisión se deriva de LLM_BASE_URL sin /v1.
# Ojo: en el equipo anfitrión, OLLAMA_HOST también fija dónde escucha el servicio de Ollama.
# OLLAMA_HOST=

# --- Hugging Face (no lo usan las demos) ---
# Secreto. Token de solo lectura o fine-grained para modelos con acceso restringido. (sin valor)
HF_TOKEN=
